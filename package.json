{
  "name": "hok-global-scrim-lab",
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server/server.js",
    "test": "node --test --test-concurrency=3 --test-timeout=120000 \"src/**/*.test.js\" \"scripts/**/*.test.js\"",
    "i18n": "node scripts/i18n/sync.mjs",
    "build": "node scripts/build/build.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "node src/testing/run-e2e.mjs",
    "translations:check": "node --env-file-if-exists=.env scripts/translations/check-deepl.mjs"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "mysql2": "^3.15.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.55.0",
    "qrcode-generator": "^2.0.4",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "esbuild": "^0.25.12",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  }
}
