GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# Secure cookies are the default in production (NODE_ENV=production). Set false only for plain-http local use.
COOKIE_SECURE=false

# Discord (optional). Linking an account needs the first three (a Discord application, OAuth2 redirect to /auth/discord/callback);
# sending direct messages needs the bot token. Without them the site works and the Discord page says it is not configured.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback
DISCORD_BOT_TOKEN=
# Needed for the buttons in direct messages and the slash commands (Developer Portal > General Information > Public Key).
DISCORD_PUBLIC_KEY=
# Where Discord sends the person who adds the bot to a team server (default: the account redirect with /bot/ inserted).
DISCORD_BOT_REDIRECT_URI=http://localhost:3000/auth/discord/bot/callback

# --- Automatic translation of what the staff writes (optional, nothing is sent without a key) ---
# The names, descriptions and notes the staff types (stats, tags, items, arcana, builds, combos, training situations) are kept as
# typed and translated by DeepL into the languages the site is read in. One line is enough: your DeepL key (a free key ends with :fx).
# Without it visitors read the texts as typed, and the Translations tab of the Catalog lets the staff translate by hand.
# Check the key with: npm run translations:check
DEEPL_API_KEY=
# Optional. Another service (anthropic, libretranslate) instead of DeepL, or `off` to switch the translation off whatever keys are here.
# These keys keep working as they were written: TRANSLATION_PROVIDER=deepl and TRANSLATION_API_KEY=<the key> are the same as DEEPL_API_KEY.
TRANSLATION_PROVIDER=
TRANSLATION_API_KEY=
# libretranslate: the address of your server (required). deepl: only to override the address (free keys are detected). anthropic: leave empty.
TRANSLATION_ENDPOINT=
# anthropic only: the model (default claude-sonnet-5-5).
TRANSLATION_MODEL=
# Optional: the most characters sent per day. With DeepL there is no need: the quota of the account is read from DeepL and the translator
# stops at 90% of it. Leave empty for no daily limit (a service that cannot say what is left is held to 400000 a day).
TRANSLATION_DAILY_CHARS=
# Seconds between two rounds that look for new texts (default 300; a round also starts a moment after the staff saves).
TRANSLATION_SWEEP_SECONDS=300

# Comma-separated verified Google emails allowed to sync the roster and import competitive data.
ADMIN_EMAILS=
# Behind a reverse proxy: number of proxy hops (e.g. 1). Leave empty when exposed directly.
TRUST_PROXY=
# Public https origin (required in production; also used for the cross-origin check).
APP_ORIGIN=
# The domain alone (e.g. scrims.example.com), for the HTTPS proxy of docker-compose.caddy.yml (see deploy/HETZNER.md).
APP_DOMAIN=
# Minimum games before a synergy/matchup from your scrims is shown (default 30).
MIN_SAMPLE_GAMES=30
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
MYSQL_DATABASE=hok_scrim
MYSQL_USER=hok_app
MYSQL_PASSWORD=replace-with-a-long-random-app-password
DB_HOST=127.0.0.1
DB_PORT=8080
DB_NAME=hok_scrim
DB_USER=hok_app
DB_PASSWORD=replace-with-a-long-random-app-password
# Or the whole database as one address, mysql://user:password@host:port/name (on Heroku the JawsDB add-on sets JAWSDB_URL,
# which is read the same way). A DB_ setting written above still wins over its part of the address.
# DB_URL=
# The pool of database connections of one process (all optional, the defaults suit a single instance).
# Behind a load balancer, instances x DB_POOL_SIZE must stay under MySQL's max_connections (151 by default).
# DB_QUEUE_LIMIT above 0 makes a request fail at once when that many are already waiting for a connection.
# DB_POOL_SIZE=10
# DB_QUEUE_LIMIT=0
# DB_CONNECT_TIMEOUT_MS=10000
# A database that is not on this machine or a private network (a hosted MySQL) MUST be reached over TLS: production
# refuses to start otherwise. TLS 1.3 only, and the certificate of the server is always checked (there is no way to switch that off).
# DB_SSL=true
# The certificate authority of a provider the system does not know (Aiven gives a ca.pem): the PEM text on one line,
# line breaks written \n. Not needed for a provider with a public authority.
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# Behind a load balancer: seconds between "this instance is leaving" (GET /api/health answers 503) and the moment it
# stops listening, so that the balancer has moved on before the connections close. 0 for a single instance.
# SHUTDOWN_DRAIN_SECONDS=0

# --- Accounts and multi-factor authentication ---
# 32 random bytes, base64 (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))").
# Encrypts the authenticator seeds in the database. REQUIRED in production; keep it out of the database and the repository.
MFA_ENCRYPTION_KEY=
# Optional secret mixed into password hashes (kept outside the database). Changing it invalidates existing passwords.
PASSWORD_PEPPER=
# Development only, when MFA_ENCRYPTION_KEY is empty: the file a random key is generated into once (git-ignored).
# MFA_KEY_FILE=.data/mfa.key
# Cost of the password hash, log2 of scrypt's N (10 to 20; production refuses less than 15).
# SCRYPT_LOG2N=17
# The name an authenticator app shows next to the codes of this site.
# AUTH_ISSUER=HOK Global Scrim Lab
# Set false to close self-service sign-up (accounts can still be created with scripts/account.js).
REGISTRATION_ENABLED=true

# The bots server (bots.hok-scrim-lab.com, private repository hok-bots), where the games of /simulation and the bots
# API run. Both empty: the games against the bots are closed. The secret is the same as the bots server's
# secrets/bots-secret (at least 32 characters); BOTS_SHARED_SECRET_FILE can name a file that holds it instead.
BOTS_URL=
BOTS_SHARED_SECRET=
